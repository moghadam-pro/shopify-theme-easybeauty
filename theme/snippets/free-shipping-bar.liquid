{%- comment -%} Shows progress toward the free-shipping threshold set in theme settings. {%- endcomment -%}
{%- liquid
  assign threshold_dollars = settings.cart_free_shipping_threshold | times: 1
  assign threshold_cents = threshold_dollars | times: 100
  assign remaining_cents = threshold_cents | minus: cart.total_price
  if remaining_cents < 0
    assign remaining_cents = 0
  endif
  assign percent = cart.total_price | times: 100.0 | divided_by: threshold_cents
  if percent > 100
    assign percent = 100
  endif
  assign remaining_formatted = remaining_cents | money
-%}
{%- if threshold_cents > 0 -%}
  <div class="free-shipping-bar" style="margin-bottom:16px">
    <p style="font-size:12.5px;margin:0">
      {%- if remaining_cents == 0 -%}
        {{ 'sections.cart.free_shipping_reached' | t }}
      {%- else -%}
        {{ 'sections.cart.free_shipping_remaining_html' | t: amount: remaining_formatted }}
      {%- endif -%}
    </p>
    <div class="free-shipping-bar__track">
      <div class="free-shipping-bar__fill" style="width:{{ percent }}%"></div>
    </div>
  </div>
{%- endif -%}
