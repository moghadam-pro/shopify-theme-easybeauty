{%- comment -%}
  Renders a product grid card.
  Usage: {% render 'product-card', product: product %}
{%- endcomment -%}
<div class="product-card">
  <a href="{{ product.url }}" class="product-card__media">
    {%- if product.featured_image -%}
      <img
        src="{{ product.featured_image | image_url: width: 800 }}"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        loading="lazy"
        width="800"
        height="{{ 800 | divided_by: product.featured_image.aspect_ratio | default: 1000 }}"
      >
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
    {%- if product.compare_at_price > product.price -%}
      <span class="tag" style="position:absolute;top:10px;left:10px">{{ 'products.product.sale' | t }}</span>
    {%- endif -%}
  </a>
  <div>
    <a href="{{ product.url }}" class="product-card__title">{{ product.title }}</a>
    <div class="product-card__price">{% render 'price', product: product %}</div>
  </div>
</div>
