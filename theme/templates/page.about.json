        "h": {
          "type": "heading",
          "settings": {
            "heading": "Twelve formulas. No seasonal launches."
          }
        },
        "t": {
          "type": "text",
          "settings": {
            "content": "<p>We ship the same twelve products, continuously improved, instead of chasing trend launches.</p>"
          }
        }
      },
