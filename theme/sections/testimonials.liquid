{%- comment -%}
  Headline rating + a grid of customer quotes + an optional row of press
  names. This is static, merchant-entered copy: live product reviews need a
  reviews app (Judge.me, Shopify Product Reviews, …), which renders its own
  widget on the product page.
{%- endcomment -%}
<section class="testimonials">
  <div class="container">
    {%- if section.settings.rating != blank or section.settings.rating_label != blank -%}
      <div class="testimonials__head">
        {%- if section.settings.rating != blank -%}
          <div class="testimonials__rating">{{ section.settings.rating }} <span aria-hidden="true">★</span></div>
        {%- endif -%}
        {%- if section.settings.rating_label != blank -%}
          <div class="testimonials__rating-label">{{ section.settings.rating_label }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="testimonials__grid">
      {%- for block in section.blocks -%}
        <figure class="testimonials__quote" {{ block.shopify_attributes }}>
          <div class="testimonials__stars" aria-label="{{ 'sections.testimonials.stars' | t: count: block.settings.stars }}">
            {%- for i in (1..block.settings.stars) -%}★{%- endfor -%}
          </div>
          <blockquote>&ldquo;{{ block.settings.quote }}&rdquo;</blockquote>
          <figcaption>
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 88 }}" alt="" width="44" height="44" loading="lazy">
            {%- elsif block.settings.fallback_image != blank -%}
              <img src="{{ block.settings.fallback_image | asset_url }}" alt="" width="44" height="44" loading="lazy">
            {%- endif -%}
            <span>{{ block.settings.author }}{% if block.settings.meta != blank %} · {{ block.settings.meta }}{% endif %}</span>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>

    {%- assign press = section.settings.press | split: ',' -%}
    {%- if section.settings.press != blank -%}
      <div class="testimonials__press">
        {%- for name in press -%}<span>{{ name | strip }}</span>{%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "settings": [
    {
      "type": "text",
      "id": "rating",
      "label": "t:sections.testimonials.settings.rating.label",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "rating_label",
      "label": "t:sections.testimonials.settings.rating_label.label",
      "default": "12,400+ verified reviews"
    },
    {
      "type": "text",
      "id": "press",
      "label": "t:sections.testimonials.settings.press.label",
      "info": "t:sections.testimonials.settings.press.info",
      "default": "Vogue, Allure, Byrdie, Refinery29"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "t:sections.testimonials.blocks.quote.name",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "t:sections.testimonials.blocks.quote.settings.quote.label"
        },
        {
          "type": "text",
          "id": "author",
          "label": "t:sections.testimonials.blocks.quote.settings.author.label"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "t:sections.testimonials.blocks.quote.settings.meta.label",
          "info": "t:sections.testimonials.blocks.quote.settings.meta.info"
        },
        {
          "type": "range",
          "id": "stars",
          "label": "t:sections.testimonials.blocks.quote.settings.stars.label",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.testimonials.blocks.quote.settings.image.label"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "t:sections.testimonials.blocks.quote.settings.fallback_image.label"
        }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    {
      "name": "t:sections.testimonials.presets.name",
      "blocks": [
        {
          "type": "quote",
          "settings": {
            "quote": "The first moisturiser in four years that did not sting. Three months in and my barrier is finally quiet.",
            "author": "Maya R.",
            "meta": "Sensitive, 34",
            "fallback_image": "lifestyle-skin.jpg"
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "I bought the bundle to try it and now I cannot use anything else in the morning. The oil is the surprise.",
            "author": "Dilan A.",
            "meta": "Combination, 41",
            "fallback_image": "lifestyle-apply.jpg"
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "Short ingredient lists, no perfume, no drama. My dermatologist had no notes.",
            "author": "Priya S.",
            "meta": "Acne-prone, 27",
            "fallback_image": "hero-banner.jpg"
          }
        }
      ]
    }
  ]
}
{% endschema %}
