{%- comment -%}
  Principles. "Split" (design: About) = eyebrow + heading on the left and a
  numbered list on the right whose rows highlight on hover; "Grid" = four
  columns under the heading.
{%- endcomment -%}
<section class="about-values about-values--{{ section.settings.layout }}">
  <div class="about-values__head">
    {%- if section.settings.eyebrow != blank -%}<div class="kicker">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="about-values__list">
    {%- for block in section.blocks -%}
      <div class="about-values__item" {{ block.shopify_attributes }}>
        <div class="about-values__num">{{ block.settings.number }}</div>
        <div>
          <div class="about-values__title">{{ block.settings.title }}</div>
          <div class="about-values__text">{{ block.settings.text }}</div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.about-values.name",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.about-values.settings.layout.label",
      "options": [
        {
          "value": "split",
          "label": "t:sections.about-values.settings.layout.options__1.label"
        },
        {
          "value": "grid",
          "label": "t:sections.about-values.settings.layout.options__2.label"
        }
      ],
      "default": "split"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.about-values.settings.eyebrow.label",
      "default": "What we hold to"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.about-values.settings.heading.label",
      "default": "Four rules that decide every formula we ship."
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "t:sections.about-values.blocks.value.name",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "t:sections.about-values.blocks.value.settings.number.label",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.about-values.blocks.value.settings.title.label"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.about-values.blocks.value.settings.text.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.about-values.name",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "number": "01",
            "title": "No fragrance unless it's functional",
            "text": "Nothing added purely for scent."
          }
        },
        {
          "type": "value",
          "settings": {
            "number": "02",
            "title": "Clinical concentrations",
            "text": "Actives dosed at the level shown to work in studies."
          }
        },
        {
          "type": "value",
          "settings": {
            "number": "03",
            "title": "Batch-tested in Portugal",
            "text": "Every batch checked before it ships."
          }
        },
        {
          "type": "value",
          "settings": {
            "number": "04",
            "title": "No seasonal launches",
            "text": "Twelve formulas, continuously improved."
          }
        }
      ]
    }
  ]
}
{% endschema %}
