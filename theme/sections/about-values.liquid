<section class="section container">
  <div class="section__head">
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="grid grid-4">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <div class="eyebrow" style="font-size:28px;color:var(--terra);font-family:var(--font-heading)">{{ block.settings.number }}</div>
        <div class="card-title" style="margin:10px 0 6px">{{ block.settings.title }}</div>
        <p class="card-body">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.about-values.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Four rules that decide every formula we ship."
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "t:sections.about-values.blocks.value.name",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "t:sections.about-values.blocks.value.settings.number.label",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.about-values.blocks.value.settings.title.label"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.about-values.blocks.value.settings.text.label"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "value",
        "settings": {
          "number": "01",
          "title": "No fragrance unless it's functional",
          "text": "Nothing added purely for scent."
        }
      },
      {
        "type": "value",
        "settings": {
          "number": "02",
          "title": "Clinical concentrations",
          "text": "Actives dosed at the level shown to work in studies."
        }
      },
      {
        "type": "value",
        "settings": {
          "number": "03",
          "title": "Batch-tested in Portugal",
          "text": "Every batch checked before it ships."
        }
      },
      {
        "type": "value",
        "settings": {
          "number": "04",
          "title": "No seasonal launches",
          "text": "Twelve formulas, continuously improved."
        }
      }
    ]
  }
}
{% endschema %}
