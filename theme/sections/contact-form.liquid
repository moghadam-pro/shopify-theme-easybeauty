<section class="section container" style="max-width:600px">
  <h1>{{ section.settings.heading }}</h1>
  {%- if section.settings.text != blank -%}<p class="text-muted">{{ section.settings.text }}</p>{%- endif -%}

  {%- form 'contact' -%}
    {%- if form.posted_successfully? -%}
      <p class="form-message form-message--success">{{ 'sections.contact.success' | t }}</p>
    {%- endif -%}

    {%- if form.errors -%}
      <div class="form-message form-message--error">
        <ul style="margin:0;padding-left:18px">
          {%- for field in form.errors -%}
            <li>{{ form.errors.translated_fields[field] }} {{ form.errors.messages[field] }}</li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="field">
      <label for="ContactName">{{ 'sections.contact.name' | t }}</label>
      <input type="text" class="input" id="ContactName" name="contact[{{ 'sections.contact.name' | t }}]" value="{{ form.name }}">
    </div>
    <div class="field">
      <label for="ContactEmail">{{ 'sections.contact.email' | t }}</label>
      <input type="email" class="input" id="ContactEmail" name="contact[email]" value="{{ form.email }}" required>
    </div>
    <div class="field">
      <label for="ContactTopic">{{ 'sections.contact.topic' | t }}</label>
      <select class="input" id="ContactTopic" name="contact[{{ 'sections.contact.topic' | t }}]">
        <option>Order question</option>
        <option>Formulation / ingredients</option>
        <option>Skin concern</option>
        <option>Press &amp; partnerships</option>
      </select>
    </div>
    <div class="field">
      <label for="ContactMessage">{{ 'sections.contact.message' | t }}</label>
      <textarea class="input" id="ContactMessage" name="contact[body]" required>{{ form.body }}</textarea>
    </div>
    <button type="submit" class="btn btn-primary btn-block">{{ 'sections.contact.submit' | t }}</button>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.contact-form.settings.heading.label",
      "default": "Talk to us"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.contact-form.settings.text.label",
      "default": "Tell us what your skin is doing and we will answer properly."
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.name"
    }
  ]
}
{% endschema %}
