{%- comment -%}
  Shopify contact form ({% form 'contact' %} → the store's contact email),
  design: Contact. Topic chips, uppercase labels, optional order number and
  newsletter opt-in (sent with the message), and a side column split by
  rules: details, a photo, more details, and "before you write" Q&A.
{%- endcomment -%}
{%- liquid
  assign has_aside = false
  if section.settings.aside_content != blank or section.settings.aside_content_2 != blank or section.settings.aside_image != blank or section.blocks.size > 0
    assign has_aside = true
  endif
  assign topics = section.settings.topics | split: ','
-%}
<section class="contact-form{% if has_aside %} contact-form--split{% endif %}">
  <div class="contact-form__main">
    {%- if section.settings.eyebrow != blank -%}<div class="kicker contact-form__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="contact-form__lead">{{ section.settings.text }}</p>{%- endif -%}

    {%- form 'contact', class: 'contact-form__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success">{{ 'sections.contact.success' | t }}</p>
      {%- endif -%}

      {%- if form.errors -%}
        <div class="form-message form-message--error">
          <ul style="margin:0;padding-left:20px">
            {%- for field in form.errors -%}
              <li>{{ form.errors.translated_fields[field] }} {{ form.errors.messages[field] }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if section.settings.topics != blank -%}
        <div role="radiogroup" aria-labelledby="ContactTopic-{{ section.id }}">
          <div class="contact-form__label" id="ContactTopic-{{ section.id }}">{{ 'sections.contact.topic' | t }}</div>
          <div class="contact-form__topics">
            {%- for topic in topics -%}
              {%- assign topic_label = topic | strip -%}
              <label class="contact-form__topic">
                <input type="radio" name="contact[{{ 'sections.contact.topic' | t }}]" value="{{ topic_label | escape }}" {% if forloop.first %}checked{% endif %}>
                <span>{{ topic_label }}</span>
              </label>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <div class="contact-form__row">
        <div class="field">
          <label for="ContactName-{{ section.id }}">{{ 'sections.contact.name' | t }}</label>
          <input type="text" class="input" id="ContactName-{{ section.id }}" name="contact[{{ 'sections.contact.name' | t }}]" value="{{ form.name }}" autocomplete="name">
        </div>
        <div class="field">
          <label for="ContactEmail-{{ section.id }}">{{ 'sections.contact.email' | t }}</label>
          <input type="email" class="input" id="ContactEmail-{{ section.id }}" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
        </div>
      </div>
      {%- if section.settings.show_order_number -%}
        <div class="field">
          <label for="ContactOrder-{{ section.id }}">{{ 'sections.contact.order_number_label' | t }} <span class="contact-form__optional">{{ 'sections.contact.optional' | t }}</span></label>
          <input type="text" class="input" id="ContactOrder-{{ section.id }}" name="contact[{{ 'sections.contact.order_number' | t }}]">
        </div>
      {%- endif -%}
      <div class="field">
        <label for="ContactMessage-{{ section.id }}">{{ 'sections.contact.message' | t }}</label>
        <textarea class="input" id="ContactMessage-{{ section.id }}" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
      </div>
      {%- if section.settings.show_consent and section.settings.consent_text != blank -%}
        <label class="contact-form__consent">
          <input type="checkbox" name="contact[{{ 'sections.contact.newsletter' | t }}]" value="{{ 'sections.contact.yes' | t }}">
          <span>{{ section.settings.consent_text }}</span>
        </label>
      {%- endif -%}
      <button type="submit" class="btn btn-primary contact-form__submit">{{ 'sections.contact.submit' | t }}</button>
    {%- endform -%}
  </div>

  {%- if has_aside -%}
    <aside class="contact-form__aside">
      {%- if section.settings.aside_content != blank -%}
        <div class="rte contact-form__block">{{ section.settings.aside_content }}</div>
      {%- endif -%}
      {%- if section.settings.aside_image != blank -%}
        <div class="contact-form__image">
          {{ section.settings.aside_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '340px', widths: '400, 800', alt: section.settings.aside_image.alt }}
        </div>
      {%- elsif section.settings.show_image -%}
        <div class="contact-form__image"><img src="{{ 'lifestyle-apply.jpg' | asset_url }}" alt="" width="800" height="533" loading="lazy"></div>
      {%- endif -%}
      {%- if section.settings.aside_content_2 != blank -%}
        <div class="rte contact-form__block">{{ section.settings.aside_content_2 }}</div>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="contact-form__faq">
          {%- if section.settings.faq_heading != blank -%}<div class="kicker">{{ section.settings.faq_heading }}</div>{%- endif -%}
          {%- for block in section.blocks -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question }}</summary>
              <div class="rte">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </aside>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.contact-form.settings.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.contact-form.settings.heading.label",
      "default": "Talk to us"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.contact-form.settings.text.label",
      "default": "Tell us what your skin is doing and we will answer properly."
    },
    {
      "type": "text",
      "id": "topics",
      "label": "t:sections.contact-form.settings.topics.label",
      "info": "t:sections.contact-form.settings.topics.info",
      "default": "Routine advice, An order, Returns, Press, Something else"
    },
    {
      "type": "checkbox",
      "id": "show_order_number",
      "label": "t:sections.contact-form.settings.show_order_number.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_consent",
      "label": "t:sections.contact-form.settings.show_consent.label",
      "default": true
    },
    {
      "type": "text",
      "id": "consent_text",
      "label": "t:sections.contact-form.settings.consent_text.label",
      "default": "Send me the every-other-Thursday letter as well. Unsubscribe in one click."
    },
    {
      "type": "richtext",
      "id": "aside_content",
      "label": "t:sections.contact-form.settings.aside_content.label",
      "info": "t:sections.contact-form.settings.aside_content.info"
    },
    {
      "type": "image_picker",
      "id": "aside_image",
      "label": "t:sections.contact-form.settings.aside_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:sections.contact-form.settings.show_image.label",
      "info": "t:sections.contact-form.settings.show_image.info",
      "default": true
    },
    {
      "type": "richtext",
      "id": "aside_content_2",
      "label": "t:sections.contact-form.settings.aside_content_2.label"
    },
    {
      "type": "text",
      "id": "faq_heading",
      "label": "t:sections.contact-form.settings.faq_heading.label",
      "default": "Before you write"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.contact-form.blocks.question.name",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:sections.contact-form.blocks.question.settings.question.label"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:sections.contact-form.blocks.question.settings.answer.label"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "t:sections.contact-form.name"
    }
  ]
}
{% endschema %}
