{%- comment -%}
  "Best skincare products, in use": a row of 9:16 reels that fills the page
  width. One reel is active at a time — it is wider and taller than the rest
  and plays; when its video ends (or after a few seconds for a still photo)
  the next reel takes over, looping back to the first after the last.
  Playback only runs while the section is on screen and is skipped entirely
  for visitors who prefer reduced motion. Clicking a reel makes it active;
  the arrows step through them. Driven by [data-reel] in theme.js — without
  JS the row is a plain horizontal scroller.
{%- endcomment -%}
<section class="section media-carousel" data-reel data-image-duration="{{ section.settings.image_duration }}">
  <div class="container section__head">
    <h2>{{ section.settings.heading }}</h2>
    <div class="media-carousel__nav">
      <button type="button" class="btn btn-secondary btn-icon" data-reel-prev aria-label="{{ 'sections.media-carousel.previous' | t }}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
      </button>
      <button type="button" class="btn btn-secondary btn-icon" data-reel-next aria-label="{{ 'sections.media-carousel.next' | t }}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
      </button>
    </div>
  </div>

  <div class="media-carousel__track" data-reel-track>
    {%- for block in section.blocks -%}
      {%- assign card_product = block.settings.product -%}
      <div class="media-carousel__item{% if forloop.first %} is-active{% endif %}" data-reel-item {{ block.shopify_attributes }}>
        <div class="media-carousel__media" data-reel-media>
          {%- if block.settings.video != blank -%}
            {{ block.settings.video | video_tag: muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '720x' }}
          {%- elsif block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 720 }}"
              srcset="{{ block.settings.image | image_url: width: 480 }} 480w, {{ block.settings.image | image_url: width: 720 }} 720w"
              sizes="(min-width: 760px) 25vw, 70vw"
              alt="{{ block.settings.image.alt | escape }}"
              width="720"
              height="1280"
              loading="lazy"
            >
          {%- else -%}
            <img src="{{ block.settings.fallback_image | default: 'lifestyle-apply.jpg' | asset_url }}" alt="" width="480" height="853" loading="lazy">
          {%- endif -%}
          <span class="media-carousel__play" aria-hidden="true">
            <svg class="media-carousel__icon-play" width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5l11 7-11 7z"/></svg>
          </span>
          <span class="media-carousel__progress" aria-hidden="true"><span data-reel-progress></span></span>
        </div>
        {%- liquid
          if card_product != blank
            assign card_title = card_product.title
            assign card_url = card_product.url
          else
            assign card_title = block.settings.fallback_title
            assign card_url = routes.all_products_collection_url
          endif
        -%}
        {%- if card_title != blank -%}
          <a href="{{ card_url }}" class="media-carousel__product">
            {%- if card_product.featured_image != blank -%}
              <img src="{{ card_product.featured_image | image_url: width: 104 }}" alt="" width="52" height="52" loading="lazy">
            {%- elsif block.settings.fallback_thumbnail != blank -%}
              <img src="{{ block.settings.fallback_thumbnail | asset_url }}" alt="" width="52" height="52" loading="lazy">
            {%- endif -%}
            <div>
              <div class="media-carousel__product-title">{{ card_title }}</div>
              <div class="media-carousel__product-price">
                {%- if card_product != blank -%}{{ card_product.price | money }}{%- else -%}{{ block.settings.fallback_price }}{%- endif -%}
              </div>
            </div>
          </a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.media-carousel.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.media-carousel.settings.heading.label",
      "default": "Best skincare products, in use"
    },
    {
      "type": "range",
      "id": "image_duration",
      "min": 2,
      "max": 15,
      "step": 1,
      "unit": "s",
      "label": "t:sections.media-carousel.settings.image_duration.label",
      "info": "t:sections.media-carousel.settings.image_duration.info",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.media-carousel.blocks.item.name",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "t:sections.media-carousel.blocks.item.settings.video.label",
          "info": "t:sections.media-carousel.blocks.item.settings.video.info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.media-carousel.blocks.item.settings.image.label",
          "info": "t:sections.media-carousel.blocks.item.settings.image.info"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "t:sections.media-carousel.blocks.item.settings.fallback_image.label"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.media-carousel.blocks.item.settings.product.label"
        },
        {
          "type": "text",
          "id": "fallback_title",
          "label": "t:sections.media-carousel.blocks.item.settings.fallback_title.label"
        },
        {
          "type": "text",
          "id": "fallback_price",
          "label": "t:sections.media-carousel.blocks.item.settings.fallback_price.label"
        },
        {
          "type": "text",
          "id": "fallback_thumbnail",
          "label": "t:sections.media-carousel.blocks.item.settings.fallback_thumbnail.label"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "t:sections.media-carousel.presets.name",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "fallback_image": "lifestyle-apply.jpg",
            "fallback_title": "Radiance Serum No.3",
            "fallback_price": "$68",
            "fallback_thumbnail": "sample-product-4.jpg"
          }
        },
        {
          "type": "item",
          "settings": {
            "fallback_image": "lifestyle-skin.jpg",
            "fallback_title": "Barrier Repair Cream",
            "fallback_price": "$58",
            "fallback_thumbnail": "sample-product-2.jpg"
          }
        },
        {
          "type": "item",
          "settings": {
            "fallback_image": "hero-banner.jpg",
            "fallback_title": "Gentle Cleansing Milk",
            "fallback_price": "$42",
            "fallback_thumbnail": "sample-product-3.jpg"
          }
        }
      ]
    }
  ]
}
{% endschema %}
