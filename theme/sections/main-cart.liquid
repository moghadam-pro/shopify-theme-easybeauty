<section class="section container" data-cart-page>
  <h1>{{ 'sections.cart.title' | t }}</h1>

  {%- if cart.item_count == 0 -%}
    <p style="padding:24px 0">{{ 'sections.cart.empty' | t }}</p>
    <a href="/collections/all" class="btn btn-primary">{{ 'sections.cart.empty_link' | t }}</a>
  {%- else -%}
    <div class="product" style="grid-template-columns:1.6fr 1fr">
      <div>
        {%- if settings.cart_show_free_shipping_bar -%}{%- render 'free-shipping-bar' -%}{%- endif -%}
        {%- for item in cart.items -%}
          <div class="cart-line" data-cart-line="{{ item.key }}">
            <a href="{{ item.url }}"><img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="200" height="{{ 200 | divided_by: item.image.aspect_ratio | default: 250 }}" loading="lazy"></a>
            <div>
              <a href="{{ item.url }}" style="font-family:var(--font-heading);font-size:17px">{{ item.product.title }}</a>
              {%- if item.variant.title != 'Default Title' -%}<div class="text-muted">{{ item.variant.title }}</div>{%- endif -%}
              <div class="quantity-selector" data-quantity-selector style="margin-top:10px">
                <button type="button" data-cart-qty-step="-1" aria-label="Decrease quantity">−</button>
                <input type="number" min="0" value="{{ item.quantity }}" data-cart-qty-input aria-label="{{ 'sections.cart.quantity' | t }}">
                <button type="button" data-cart-qty-step="1" aria-label="Increase quantity">+</button>
              </div>
            </div>
            <div style="text-align:right">
              <div>{{ item.final_line_price | money }}</div>
              <button type="button" class="btn-ghost" data-cart-remove="{{ item.key }}" style="margin-top:10px">{{ 'sections.cart.remove' | t }}</button>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="cart-summary">
        <div style="display:flex;justify-content:space-between;margin-bottom:12px">
          <span>{{ 'sections.cart.subtotal' | t }}</span>
          <strong>{{ cart.total_price | money }}</strong>
        </div>
        <p class="text-muted" style="font-size:12px;margin-bottom:20px">{{ 'sections.cart.shipping_at_checkout' | t }}</p>
        {%- form 'cart' -%}
          <button type="submit" name="checkout" class="btn btn-primary btn-block">{{ 'sections.cart.checkout' | t }}</button>
        {%- endform -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:sections.main-cart.name",
  "settings": [

  ]
}
{% endschema %}
