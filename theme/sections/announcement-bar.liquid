{%- if section.blocks.size > 0 -%}
  <div class="announcement-bar" data-announcement-bar {{ section.shopify_attributes }}>
    {%- for block in section.blocks -%}
      <div class="announcement-bar__item" {{ block.shopify_attributes }} {% unless forloop.first %}hidden{% endunless %}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" style="color:inherit">{{ block.settings.text }}</a>
        {%- else -%}
          <span>{{ block.settings.text }}</span>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <script>
      (() => {
        const bar = document.currentScript.closest('.shopify-section') || document;
        const items = bar.querySelectorAll('.announcement-bar__item');
        if (items.length < 2) return;
        let i = 0;
        setInterval(() => {
          items[i].hidden = true;
          i = (i + 1) % items.length;
          items[i].hidden = false;
        }, 4500);
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label",
          "default": "Free delivery over $75 · 60-day returns"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "announcement",
        "settings": {
          "text": "Free delivery over $75 · 60-day returns"
        }
      },
      {
        "type": "announcement",
        "settings": {
          "text": "Dermatologist tested · Fragrance-free options"
        }
      },
      {
        "type": "announcement",
        "settings": {
          "text": "Twelve formulas, no seasonal launches"
        }
      }
    ]
  }
}
{% endschema %}
