<section class="section container" style="max-width:420px">
  <h1>{{ 'customer.login_page.title' | t }}</h1>

  {%- form 'customer_login' -%}
    {%- if form.errors -%}
      <div class="form-message form-message--error">{{ form.errors | default_errors }}</div>
    {%- endif -%}

    <div class="field">
      <label for="CustomerEmail">{{ 'customer.login_page.email' | t }}</label>
      <input type="email" name="customer[email]" id="CustomerEmail" class="input" autocomplete="email" required>
    </div>

    {%- if form.password_needed -%}
      <div class="field">
        <label for="CustomerPassword">{{ 'customer.login_page.password' | t }}</label>
        <input type="password" name="customer[password]" id="CustomerPassword" class="input" autocomplete="current-password" required>
      </div>
      <p style="margin-bottom:var(--space-4)">
        <a href="#recover" class="btn-ghost" data-toggle-recover>{{ 'customer.login_page.forgot_password' | t }}</a>
      </p>
    {%- endif -%}

    <button type="submit" class="btn btn-primary btn-block">{{ 'customer.login_page.sign_in' | t }}</button>
  {%- endform -%}

  <div id="recover" style="display:none;margin-top:var(--space-8);padding-top:var(--space-8);border-top:1px solid var(--color-border)">
    <h2 style="font-size:20px">{{ 'customer.recover_password.title' | t }}</h2>
    <p class="text-muted">{{ 'customer.recover_password.subtext' | t }}</p>
    {%- form 'recover_customer_password' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success">{{ 'customer.recover_password.success' | t }}</p>
      {%- endif -%}
      <div class="field">
        <label for="RecoverEmail">{{ 'customer.login_page.email' | t }}</label>
        <input type="email" name="email" id="RecoverEmail" class="input" required>
      </div>
      <button type="submit" class="btn btn-secondary btn-block">{{ 'customer.recover_password.submit' | t }}</button>
    {%- endform -%}
  </div>

  {%- if shop.checkout.guest_login -%}
    <div style="margin-top:var(--space-8);padding-top:var(--space-8);border-top:1px solid var(--color-border)">
      <h2 style="font-size:20px">{{ 'customer.login_page.guest_title' | t }}</h2>
      {%- form 'guest_login' -%}
        <button type="submit" class="btn btn-secondary btn-block">{{ 'customer.login_page.guest_continue' | t }}</button>
      {%- endform -%}
    </div>
  {%- endif -%}

  {%- if shop.customer_accounts_optional? and shop.customer_accounts_enabled? -%}
    <p style="margin-top:var(--space-6);text-align:center">
      <a href="{{ routes.account_register_url }}">{{ 'customer.login_page.create_account' | t }}</a>
    </p>
  {%- endif -%}
</section>

<script>
  document.addEventListener('click', function (e) {
    if (e.target.closest('[data-toggle-recover]')) {
      e.preventDefault();
      document.getElementById('recover').style.display = 'block';
    }
  });
</script>

{% schema %}
{
  "name": "t:sections.main-customer-login.name",
  "settings": [

  ]
}
{% endschema %}
