{%- comment -%}
  Skin quiz (design: EasyBeauty Quiz).
    intro     split: copy + start button on the left, photo on the right
    questions one centred, softly framed card per question, with progress,
              "Question 2 of 6" and Back / Next. Single-answer questions
              advance on tap (no radio dots); multi-answer questions show
              checkboxes and a Next button.
    result    "Your routine": heading, answer tags, the best-matching
              products (scored by product tags vs. answer tags), routine
              total with "Add all to bag", retake, and a recap of the answers.
  Driven by [data-quiz] in theme.js. Every question is a block with up to
  four options (label, note, tag).
{%- endcomment -%}
{%- liquid
  assign question_blocks = section.blocks | where: 'type', 'question'
  assign question_count = question_blocks.size
  assign result_collection = section.settings.result_collection | default: collections.all
  assign start_label = section.settings.start_label
  if start_label == blank
    assign start_label = 'sections.quiz.start' | t
  endif
-%}
<section class="quiz-page" data-quiz data-count="{{ question_count }}">
  <div class="quiz-intro" data-quiz-step="intro">
    <div class="quiz-intro__copy">
      {%- if section.settings.eyebrow != blank -%}<div class="quiz__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h1 class="quiz-intro__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="quiz-intro__text">{{ section.settings.text }}</p>{%- endif -%}
      <div class="quiz-intro__actions">
        <button type="button" class="btn btn-primary" data-quiz-start>{{ start_label }}</button>
        <a href="{{ routes.all_products_collection_url }}" class="quiz__link">{{ 'sections.quiz.skip' | t }}</a>
      </div>
      {%- if section.settings.trust != blank -%}
        <div class="quiz-intro__trust">
          {%- assign trust = section.settings.trust | split: '|' -%}
          {%- for item in trust -%}<span>{{ item | strip }}</span>{%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div class="quiz-intro__media">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ section.settings.image.alt | escape }}" width="1400" height="{{ 1400 | divided_by: section.settings.image.aspect_ratio | round }}" loading="eager">
      {%- else -%}
        <img src="{{ 'lifestyle-skin.jpg' | asset_url }}" alt="" width="1200" height="1500" loading="eager">
      {%- endif -%}
    </div>
  </div>

  <div class="quiz-stage" data-quiz-stage hidden>
    <div class="quiz-card">
      <div class="quiz-card__progress" aria-hidden="true"><span data-quiz-progress></span></div>
      {%- for block in question_blocks -%}
        {%- liquid
          assign multi = block.settings.multi
          assign option_count = 0
          for i in (1..4)
            assign label_key = 'option_' | append: i
            if block.settings[label_key] != blank
              assign option_count = option_count | plus: 1
            endif
          endfor
        -%}
        <div
          role="group"
          aria-labelledby="QuizQ-{{ block.id }}"
          class="quiz-question"
          data-quiz-step="q{{ forloop.index }}"
          data-question="{{ block.settings.question | escape }}"
          data-multi="{{ multi }}"
          data-max="{{ block.settings.max_choices }}"
          {{ block.shopify_attributes }}
          hidden
        >
          <div class="quiz-question__top">
            <span class="quiz__eyebrow">{{ 'sections.quiz.step' | t: current: forloop.index, total: question_count }}</span>
          </div>
          <h2 class="quiz-question__title" id="QuizQ-{{ block.id }}">{{ block.settings.question }}</h2>
          {%- if block.settings.hint != blank -%}<p class="quiz-question__hint">{{ block.settings.hint }}</p>{%- endif -%}

          <div class="quiz-options quiz-options--{{ option_count }}">
            {%- for i in (1..4) -%}
              {%- liquid
                assign label_key = 'option_' | append: i
                assign note_key = 'note_' | append: i
                assign tag_key = 'tag_' | append: i
                assign option_label = block.settings[label_key]
              -%}
              {%- if option_label != blank -%}
                <label class="quiz-option{% if multi %} quiz-option--multi{% endif %}">
                  <input
                    type="{% if multi %}checkbox{% else %}radio{% endif %}"
                    name="quiz-{{ block.id }}"
                    value="{{ block.settings[tag_key] | escape }}"
                    data-label="{{ option_label | escape }}"
                    data-quiz-input
                  >
                  {%- if multi -%}
                    <span class="quiz-option__check" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4"><path d="M5 12.5l4.5 4.5L19 7"/></svg></span>
                  {%- endif -%}
                  <span class="quiz-option__text">
                    <span class="quiz-option__label">{{ option_label }}</span>
                    {%- if block.settings[note_key] != blank -%}<span class="quiz-option__note">{{ block.settings[note_key] }}</span>{%- endif -%}
                  </span>
                </label>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <div class="quiz-question__actions">
            <button type="button" class="btn btn-secondary" data-quiz-back>{{ 'sections.quiz.back' | t }}</button>
            {%- if multi -%}
              <button type="button" class="btn btn-primary" data-quiz-next disabled>
                {%- if forloop.last -%}{{ 'sections.quiz.see_results' | t }}{%- else -%}{{ 'sections.quiz.next' | t }}{%- endif -%}
              </button>
            {%- endif -%}
          </div>
          <p class="quiz-question__note">
            {%- if multi -%}{{ 'sections.quiz.pick_up_to' | t: count: block.settings.max_choices }}{%- else -%}{{ 'sections.quiz.tap_to_continue' | t }}{%- endif -%}
          </p>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="quiz-result" data-quiz-step="result" hidden>
    <div class="quiz-result__head">
      <div class="quiz__eyebrow quiz__eyebrow--accent">{{ section.settings.result_eyebrow }}</div>
      <h2 class="quiz-result__title">{{ section.settings.result_heading }}</h2>
      {%- if section.settings.result_text != blank -%}<p class="quiz-result__text">{{ section.settings.result_text }}</p>{%- endif -%}
      <div class="quiz-result__tags" data-quiz-tags></div>
    </div>

    <div class="quiz-result__grid" data-quiz-results data-limit="{{ section.settings.result_count }}">
      {%- for product in result_collection.products limit: 24 -%}
        <div class="quiz-result__item" data-quiz-product data-tags="{{ product.tags | join: ',' | downcase | escape }}" data-variant-id="{{ product.selected_or_first_available_variant.id }}" data-price="{{ product.selected_or_first_available_variant.price }}" {% unless product.available %}data-unavailable{% endunless %} hidden>
          {% render 'product-card', product: product %}
        </div>
      {%- endfor -%}
    </div>

    <div class="quiz-result__bar">
      <div>
        <div class="quiz__eyebrow">{{ 'sections.quiz.routine_total' | t }}</div>
        <div class="quiz-result__total" data-quiz-total></div>
      </div>
      <button type="button" class="btn btn-primary" data-quiz-add>{{ 'sections.quiz.add_routine_to_bag' | t }}</button>
      <button type="button" class="quiz__link" data-quiz-restart>{{ 'sections.quiz.retake' | t }}</button>
      <a href="{{ routes.all_products_collection_url }}" class="quiz__link quiz__link--muted">{{ 'sections.quiz.browse' | t }}</a>
      <p class="quiz-result__error" data-quiz-error hidden></p>
    </div>

    <div class="quiz-result__recap">
      <div class="quiz__eyebrow">{{ 'sections.quiz.you_told_us' | t }}</div>
      <dl class="quiz-result__recap-grid" data-quiz-recap></dl>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.quiz.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.quiz.settings.header_intro.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.quiz.settings.eyebrow.label",
      "default": "Six questions · about a minute"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.quiz.settings.heading.label",
      "default": "Twelve products, narrowed to a routine."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.quiz.settings.text.label",
      "default": "No email required, no account. Answer what your skin is doing right now — not what it did last winter — and we match formulas to it."
    },
    {
      "type": "text",
      "id": "start_label",
      "label": "t:sections.quiz.settings.start_label.label"
    },
    {
      "type": "text",
      "id": "trust",
      "label": "t:sections.quiz.settings.trust.label",
      "info": "t:sections.quiz.settings.trust.info",
      "default": "Reviewed by a dermatologist | No data sold"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.quiz.settings.image.label"
    },
    {
      "type": "header",
      "content": "t:sections.quiz.settings.header_result.content"
    },
    {
      "type": "text",
      "id": "result_eyebrow",
      "label": "t:sections.quiz.settings.result_eyebrow.label",
      "default": "Your routine"
    },
    {
      "type": "text",
      "id": "result_heading",
      "label": "t:sections.quiz.settings.result_heading.label",
      "default": "A routine built around your barrier."
    },
    {
      "type": "textarea",
      "id": "result_text",
      "label": "t:sections.quiz.settings.result_text.label",
      "default": "Everything here is fragrance-free, and the treat step is the only active — that is deliberate, because stacking them is what breaks skin."
    },
    {
      "type": "collection",
      "id": "result_collection",
      "label": "t:sections.quiz.settings.result_collection.label",
      "info": "t:sections.quiz.settings.result_collection.info"
    },
    {
      "type": "range",
      "id": "result_count",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "t:sections.quiz.settings.result_count.label",
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.quiz.blocks.question.name",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:sections.quiz.blocks.question.settings.question.label"
        },
        {
          "type": "text",
          "id": "hint",
          "label": "t:sections.quiz.blocks.question.settings.hint.label"
        },
        {
          "type": "checkbox",
          "id": "multi",
          "label": "t:sections.quiz.blocks.question.settings.multi.label",
          "default": false
        },
        {
          "type": "range",
          "id": "max_choices",
          "min": 2,
          "max": 4,
          "step": 1,
          "label": "t:sections.quiz.blocks.question.settings.max_choices.label",
          "default": 2
        },
        {
          "type": "text",
          "id": "option_1",
          "label": "t:sections.quiz.blocks.question.settings.option_1.label"
        },
        {
          "type": "text",
          "id": "note_1",
          "label": "t:sections.quiz.blocks.question.settings.note.label"
        },
        {
          "type": "text",
          "id": "tag_1",
          "label": "t:sections.quiz.blocks.question.settings.tag_1.label"
        },
        {
          "type": "text",
          "id": "option_2",
          "label": "t:sections.quiz.blocks.question.settings.option_2.label"
        },
        {
          "type": "text",
          "id": "note_2",
          "label": "t:sections.quiz.blocks.question.settings.note.label"
        },
        {
          "type": "text",
          "id": "tag_2",
          "label": "t:sections.quiz.blocks.question.settings.tag_2.label"
        },
        {
          "type": "text",
          "id": "option_3",
          "label": "t:sections.quiz.blocks.question.settings.option_3.label"
        },
        {
          "type": "text",
          "id": "note_3",
          "label": "t:sections.quiz.blocks.question.settings.note.label"
        },
        {
          "type": "text",
          "id": "tag_3",
          "label": "t:sections.quiz.blocks.question.settings.tag_3.label"
        },
        {
          "type": "text",
          "id": "option_4",
          "label": "t:sections.quiz.blocks.question.settings.option_4.label"
        },
        {
          "type": "text",
          "id": "note_4",
          "label": "t:sections.quiz.blocks.question.settings.note.label"
        },
        {
          "type": "text",
          "id": "tag_4",
          "label": "t:sections.quiz.blocks.question.settings.tag_4.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.quiz.name"
    }
  ]
}
{% endschema %}
