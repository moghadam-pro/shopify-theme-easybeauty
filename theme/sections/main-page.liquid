<div class="color-scheme color-{{ section.settings.color_scheme }}">
<section class="section container" style="max-width:760px">
  <h1>{{ page.title }}</h1>
  <div class="rte">{{ page.content }}</div>
</section>
</div>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
