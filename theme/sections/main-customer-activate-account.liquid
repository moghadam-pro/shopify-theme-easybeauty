<section class="section container" style="max-width:420px">
  <h1>{{ 'customer.activate_account.title' | t }}</h1>
  <p class="text-muted">{{ 'customer.activate_account.subtext' | t }}</p>

  {%- form 'activate_customer_password' -%}
    {%- if form.errors -%}
      <div class="form-message form-message--error">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div class="field">
      <label for="ActivatePassword">{{ 'customer.activate_account.password' | t }}</label>
      <input type="password" name="customer[password]" id="ActivatePassword" class="input" required>
    </div>
    <div class="field">
      <label for="ActivatePasswordConfirm">{{ 'customer.activate_account.password_confirm' | t }}</label>
      <input type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirm" class="input" required>
    </div>
    <button type="submit" class="btn btn-primary btn-block" style="margin-bottom:8px">{{ 'customer.activate_account.submit' | t }}</button>
    <button type="submit" name="decline" class="btn btn-secondary btn-block">{{ 'customer.activate_account.cancel' | t }}</button>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "t:sections.main-customer-activate-account.name",
  "settings": [

  ]
}
{% endschema %}
