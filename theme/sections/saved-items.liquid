{%- comment -%}
  Products saved for later in this browser. Rendered client-side from the
  saved list ([data-saved-list] in theme.js) — each card has "Move to bag"
  and "Remove". Used on the Saved page and under the cart ("Saved for
  later", hidden when nothing is saved).
{%- endcomment -%}
<section
  class="saved-items"
  data-saved-section
  {% if section.settings.hide_when_empty %}data-hide-when-empty hidden{% endif %}
>
  <div class="saved-items__head">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
  </div>
  <div
    data-saved-list
    data-move-label="{{ 'products.product.move_to_bag' | t | escape }}"
    data-remove-label="{{ 'sections.cart.remove' | t | escape }}"
    data-in-stock="{{ 'products.product.in_stock' | t | escape }}"
    data-sold-out="{{ 'products.product.sold_out' | t | escape }}"
  >
    <p class="saved-items__empty" data-saved-empty>{{ 'products.product.saved_empty' | t }}</p>
    <div class="saved-items__grid" data-saved-grid></div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.saved-items.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.saved-items.settings.heading.label",
      "default": "Saved"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.saved-items.settings.text.label",
      "default": "Kept on this device until you move them to the bag."
    },
    {
      "type": "checkbox",
      "id": "hide_when_empty",
      "label": "t:sections.saved-items.settings.hide_when_empty.label",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:sections.saved-items.presets.name"
    }
  ]
}
{% endschema %}
