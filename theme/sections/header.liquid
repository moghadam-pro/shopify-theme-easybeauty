{%- comment -%}
  Site header: nav (left), logo (centre), search / account / bag (right).

  Mega menu — built from the header menu (Online Store → Navigation):
    level 1 links  → header nav items
    level 2 links  → columns (link title = column title, link URL = the
                     column's "all" link)
    level 3 links  → column items; collection links show their product count
  A "Mega menu" block whose "Menu item" matches a level-1 title (e.g. Shop)
  adds the featured card, the footnote bar and custom "all" labels. Links
  without children render as plain nav items.

  Account: signed-out → login link; signed-in → initials button with a
  dropdown (orders, addresses, saved, log out). Customer accounts may be
  Shopify-hosted (new customer accounts); routes.* resolve either way.
{%- endcomment -%}
{%- liquid
  assign menu = section.settings.menu
  if customer
    assign first_initial = customer.first_name | default: customer.email | slice: 0 | upcase
    assign last_initial = customer.last_name | slice: 0 | upcase
    assign initials = first_initial | append: last_initial
  endif
-%}
<header class="site-header" data-site-header {% if section.settings.sticky %}data-sticky{% endif %}>
  <div class="site-header__bar container" data-site-nav>
    <nav class="site-header__nav" aria-label="{{ 'sections.header.menu' | t }}">
      {%- for link in menu.links -%}
        {%- if link.links != blank -%}
          <a
            href="{{ link.url }}"
            data-mega-trigger
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="MegaPanel-{{ section.id }}-{{ forloop.index }}"
            {% if link.active or link.child_active %}aria-current="page"{% endif %}
          >
            <span>{{ link.title }}</span>
            <span class="site-header__caret">{% render 'icon', icon: 'chevron-down', size: 10 %}</span>
          </a>
        {%- else -%}
          <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <a href="{{ routes.root_url }}" class="site-header__logo">
      {%- if section.settings.logo -%}
        <img
          src="{{ section.settings.logo | image_url: width: 320 }}"
          alt="{{ shop.name }}"
          width="320"
          height="{{ 320 | divided_by: section.settings.logo.aspect_ratio | round }}"
          loading="eager"
          style="height:32px;width:auto"
        >
      {%- else -%}
        {{ section.settings.logo_text | default: shop.name }}
      {%- endif -%}
    </a>

    <div class="site-header__actions">
      <button type="button" class="site-header__icon-btn" data-search-drawer-open aria-label="{{ 'general.search.search' | t }}">
        {% render 'icon', icon: 'search' %}
      </button>

      {%- if customer -%}
        <div class="account-menu" data-account-menu>
          <button type="button" class="site-header__icon-btn account-menu__trigger" aria-haspopup="true" aria-expanded="false" aria-controls="AccountMenu-{{ section.id }}" aria-label="{{ 'sections.header.account' | t }}" data-account-menu-toggle>
            <span class="account-menu__initials">{{ initials }}</span>
          </button>
          <div class="account-menu__panel" id="AccountMenu-{{ section.id }}" hidden>
            <div class="account-menu__head">
              <span class="account-menu__avatar">{{ initials }}</span>
              <div>
                <div class="account-menu__name">{{ customer.name | default: customer.email }}</div>
                {%- if customer.name != blank -%}<div class="account-menu__meta">{{ customer.email }}</div>{%- endif -%}
              </div>
            </div>
            <a href="{{ routes.account_url }}">
              <span>{{ 'sections.header.account_orders' | t }}</span>
              {%- if customer.orders_count > 0 -%}<span class="account-menu__note">{{ customer.orders_count }}</span>{%- endif -%}
            </a>
            <a href="{{ routes.account_addresses_url }}"><span>{{ 'sections.header.account_addresses' | t }}</span></a>
            {%- if section.settings.saved_link != blank -%}
              <a href="{{ section.settings.saved_link }}">
                <span>{{ 'sections.header.account_saved' | t }}</span>
                <span class="account-menu__note" data-saved-count></span>
              </a>
            {%- endif -%}
            <a href="{{ routes.account_logout_url }}" class="account-menu__logout">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M10 19H6a2 2 0 01-2-2V7a2 2 0 012-2h4M16 12H9M14 8l4 4-4 4"/></svg>
              {{ 'sections.header.log_out' | t }}
            </a>
          </div>
        </div>
      {%- else -%}
        <a href="{{ routes.account_login_url }}" class="site-header__icon-btn" aria-label="{{ 'sections.header.account' | t }}">
          {% render 'icon', icon: 'account' %}
        </a>
      {%- endif -%}

      <button type="button" class="site-header__icon-btn" data-cart-drawer-open aria-label="{{ 'sections.header.cart' | t }}">
        {% render 'icon', icon: 'bag' %}
        <span class="site-header__cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </button>
      <button type="button" class="site-header__icon-btn site-header__menu-btn" data-mobile-menu-toggle aria-label="{{ 'sections.header.menu' | t }}">
        {% render 'icon', icon: 'menu' %}
      </button>
    </div>

    {%- comment -%}
      Mega panels live inside [data-site-nav] so moving the pointer from a
      trigger down into its panel stays inside the subtree theme.js watches
      for mouseleave. They are positioned against the sticky <header>.
    {%- endcomment -%}
    {%- for link in menu.links -%}
      {%- if link.links == blank -%}{%- continue -%}{%- endif -%}
      {%- liquid
        assign mega = nil
        assign link_key = link.title | handleize
        for block in section.blocks
          assign block_key = block.settings.menu_item | handleize
          if block_key == link_key
            assign mega = block
          endif
        endfor
        assign column_count = link.links.size
        if column_count > 4
          assign column_count = 4
        endif
      -%}
      <div class="mega-panel" id="MegaPanel-{{ section.id }}-{{ forloop.index }}" data-mega-panel {% if mega %}{{ mega.shopify_attributes }}{% endif %}>
        <div class="mega-panel__inner{% if mega and mega.settings.feature_title != blank %} has-feature{% endif %}">
          <div class="mega-panel__columns" style="--mega-cols: {{ column_count }}">
            {%- for column in link.links limit: 4 -%}
              <div class="mega-panel__column">
                <div class="mega-panel__title">{{ column.title }}</div>
                <div class="mega-panel__items">
                  {%- for item in column.links -%}
                    <a href="{{ item.url }}" {% if item.active %}aria-current="page"{% endif %}>
                      <span>{{ item.title }}</span>
                      {%- if item.type == 'collection_link' and item.object.products_count > 0 -%}
                        <span class="mega-panel__note">{{ item.object.products_count }}</span>
                      {%- endif -%}
                    </a>
                  {%- endfor -%}
                </div>
                {%- liquid
                  case forloop.index
                    when 1
                      assign all_label = mega.settings.all_label_1
                    when 2
                      assign all_label = mega.settings.all_label_2
                    when 3
                      assign all_label = mega.settings.all_label_3
                    else
                      assign all_label = mega.settings.all_label_4
                  endcase
                  if all_label == blank
                    assign all_label = 'sections.header.view_all' | t
                  endif
                -%}
                <a href="{{ column.url }}" class="mega-panel__all">{{ all_label }}</a>
              </div>
            {%- endfor -%}
          </div>

          {%- if mega and mega.settings.feature_title != blank -%}
            <div class="mega-panel__feature">
              <a href="{{ mega.settings.feature_link | default: link.url }}" class="mega-panel__feature-media" aria-label="{{ mega.settings.feature_title | escape }}">
                {%- if mega.settings.feature_image != blank -%}
                  <img src="{{ mega.settings.feature_image | image_url: width: 700 }}" alt="" width="700" height="{{ 700 | divided_by: mega.settings.feature_image.aspect_ratio | round }}" loading="lazy">
                {%- else -%}
                  <img src="{{ mega.settings.feature_fallback_image | default: 'sample-product-4.jpg' | asset_url }}" alt="" width="700" height="700" loading="lazy">
                {%- endif -%}
              </a>
              <div class="mega-panel__feature-body">
                {%- if mega.settings.feature_kicker != blank -%}<div class="mega-panel__title">{{ mega.settings.feature_kicker }}</div>{%- endif -%}
                <div class="mega-panel__feature-title">{{ mega.settings.feature_title }}</div>
                {%- if mega.settings.feature_text != blank -%}<p>{{ mega.settings.feature_text }}</p>{%- endif -%}
                {%- if mega.settings.feature_button != blank -%}
                  <a href="{{ mega.settings.feature_link | default: link.url }}" class="btn btn-primary">{{ mega.settings.feature_button }}</a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>

        {%- if mega and mega.settings.footnote != blank -%}
          <div class="mega-panel__footnote">
            <span>{{ mega.settings.footnote }}</span>
            <span class="mega-panel__footnote-links">
              {%- if mega.settings.footnote_link_label_1 != blank -%}<a href="{{ mega.settings.footnote_link_1 }}">{{ mega.settings.footnote_link_label_1 }}</a>{%- endif -%}
              {%- if mega.settings.footnote_link_label_2 != blank -%}<a href="{{ mega.settings.footnote_link_2 }}">{{ mega.settings.footnote_link_label_2 }}</a>{%- endif -%}
            </span>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="mobile-nav-panel" data-mobile-menu aria-hidden="true">
    <div class="mobile-nav-panel__head">
      <span class="site-header__logo" style="font-size:20px">{{ section.settings.logo_text | default: shop.name }}</span>
      <button type="button" class="btn-icon" data-mobile-menu-toggle aria-label="{{ 'general.accessibility.close' | t }}">
        {% render 'icon', icon: 'close' %}
      </button>
    </div>
    <nav class="mobile-nav-panel__links" aria-label="{{ 'sections.header.menu' | t }}">
      {%- for link in menu.links -%}
        {%- if link.links != blank -%}
          <details>
            <summary>{{ link.title }}</summary>
            <div class="mobile-nav-panel__sublinks">
              {%- for column in link.links -%}
                {%- if column.links != blank -%}
                  <div class="mobile-nav-panel__group">{{ column.title }}</div>
                  {%- for item in column.links -%}
                    <a href="{{ item.url }}">{{ item.title }}</a>
                  {%- endfor -%}
                {%- else -%}
                  <a href="{{ column.url }}">{{ column.title }}</a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </details>
        {%- else -%}
          <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>
  </div>
</header>
<div class="mega-scrim" data-mega-scrim hidden></div>

{% schema %}
{
  "name": "t:sections.header.name",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.header.settings.menu.label",
      "info": "t:sections.header.settings.menu.info",
      "default": "main-menu"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.header.settings.logo.label"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "t:sections.header.settings.logo_text.label",
      "default": "EasyBeauty"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "t:sections.header.settings.sticky.label",
      "default": true
    },
    {
      "type": "url",
      "id": "saved_link",
      "label": "t:sections.header.settings.saved_link.label",
      "info": "t:sections.header.settings.saved_link.info"
    }
  ],
  "blocks": [
    {
      "type": "mega",
      "name": "t:sections.header.blocks.mega.name",
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "t:sections.header.blocks.mega.settings.menu_item.label",
          "info": "t:sections.header.blocks.mega.settings.menu_item.info"
        },
        {
          "type": "text",
          "id": "all_label_1",
          "label": "t:sections.header.blocks.mega.settings.all_label_1.label"
        },
        {
          "type": "text",
          "id": "all_label_2",
          "label": "t:sections.header.blocks.mega.settings.all_label_2.label"
        },
        {
          "type": "text",
          "id": "all_label_3",
          "label": "t:sections.header.blocks.mega.settings.all_label_3.label"
        },
        {
          "type": "text",
          "id": "all_label_4",
          "label": "t:sections.header.blocks.mega.settings.all_label_4.label"
        },
        {
          "type": "image_picker",
          "id": "feature_image",
          "label": "t:sections.header.blocks.mega.settings.feature_image.label"
        },
        {
          "type": "text",
          "id": "feature_fallback_image",
          "label": "t:sections.header.blocks.mega.settings.feature_fallback_image.label"
        },
        {
          "type": "text",
          "id": "feature_kicker",
          "label": "t:sections.header.blocks.mega.settings.feature_kicker.label"
        },
        {
          "type": "text",
          "id": "feature_title",
          "label": "t:sections.header.blocks.mega.settings.feature_title.label"
        },
        {
          "type": "textarea",
          "id": "feature_text",
          "label": "t:sections.header.blocks.mega.settings.feature_text.label"
        },
        {
          "type": "text",
          "id": "feature_button",
          "label": "t:sections.header.blocks.mega.settings.feature_button.label"
        },
        {
          "type": "url",
          "id": "feature_link",
          "label": "t:sections.header.blocks.mega.settings.feature_link.label"
        },
        {
          "type": "text",
          "id": "footnote",
          "label": "t:sections.header.blocks.mega.settings.footnote.label"
        },
        {
          "type": "text",
          "id": "footnote_link_label_1",
          "label": "t:sections.header.blocks.mega.settings.footnote_link_label_1.label"
        },
        {
          "type": "url",
          "id": "footnote_link_1",
          "label": "t:sections.header.blocks.mega.settings.footnote_link_1.label"
        },
        {
          "type": "text",
          "id": "footnote_link_label_2",
          "label": "t:sections.header.blocks.mega.settings.footnote_link_label_2.label"
        },
        {
          "type": "url",
          "id": "footnote_link_2",
          "label": "t:sections.header.blocks.mega.settings.footnote_link_2.label"
        }
      ]
    }
  ]
}
{% endschema %}
