<header class="site-header" data-site-header {% if section.settings.sticky %}style="position:sticky;top:0"{% endif %}>
  <div class="site-header__bar container" data-site-nav>
    <nav class="site-header__nav" aria-label="{{ 'sections.header.menu' | t }}">
      {%- for link in section.settings.menu.links -%}
        {%- if link.links != blank -%}
          <a
            href="{{ link.url }}"
            data-mega-trigger
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="MegaPanel-{{ forloop.index }}"
            {% if link.active %}aria-current="page"{% endif %}
          >
            <span>{{ link.title }}</span>
            {% render 'icon', icon: 'chevron-down', size: 10 %}
          </a>
        {%- else -%}
          <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <a href="{{ routes.root_url }}" class="site-header__logo">
      {%- if section.settings.logo -%}
        <img
          src="{{ section.settings.logo | image_url: width: 320 }}"
          alt="{{ shop.name }}"
          width="320"
          height="{{ 320 | divided_by: section.settings.logo.aspect_ratio | default: 32 }}"
          loading="eager"
          style="height:32px;width:auto"
        >
      {%- else -%}
        {{ section.settings.logo_text | default: shop.name }}
      {%- endif -%}
    </a>

    <div class="site-header__actions">
      <button type="button" class="site-header__icon-btn" data-search-drawer-open aria-label="{{ 'general.search.search' | t }}">
        {% render 'icon', icon: 'search' %}
      </button>
      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="site-header__icon-btn" aria-label="{{ 'sections.header.account' | t }}">
        {% render 'icon', icon: 'account' %}
      </a>
      <button type="button" class="site-header__icon-btn" data-cart-drawer-open aria-label="{{ 'sections.header.cart' | t }}">
        {% render 'icon', icon: 'bag' %}
        <span class="site-header__cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </button>
      <button type="button" class="site-header__icon-btn" data-mobile-menu-toggle aria-label="{{ 'sections.header.menu' | t }}" style="display:none">
        {% render 'icon', icon: 'menu' %}
      </button>
    </div>

    {%- comment -%}
      Mega panels live inside [data-site-nav] (not just after it) so that
      moving the pointer from a trigger down into its panel stays within the
      DOM subtree theme.js watches for mouseleave — panels are absolutely
      positioned against the sticky <header>, so nesting them here doesn't
      change where they render.
    {%- endcomment -%}
    {%- for link in section.settings.menu.links -%}
      {%- if link.links != blank -%}
        <div class="mega-panel" id="MegaPanel-{{ forloop.index }}" data-mega-panel>
          <div class="container mega-panel__grid">
            {%- for sublink in link.links -%}
              <a href="{{ sublink.url }}">{{ sublink.title }}</a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="mobile-nav-panel" data-mobile-menu aria-hidden="true">
    <div class="mobile-nav-panel__head">
      <span class="site-header__logo" style="font-size:20px">{{ section.settings.logo_text | default: shop.name }}</span>
      <button type="button" class="btn-icon" data-mobile-menu-toggle aria-label="{{ 'general.accessibility.close' | t }}">
        {% render 'icon', icon: 'close' %}
      </button>
    </div>
    <nav class="mobile-nav-panel__links" aria-label="{{ 'sections.header.menu' | t }}">
      {%- for link in section.settings.menu.links -%}
        {%- if link.links != blank -%}
          <details>
            <summary>{{ link.title }}</summary>
            <div class="mobile-nav-panel__sublinks">
              {%- for sublink in link.links -%}
                <a href="{{ sublink.url }}">{{ sublink.title }}</a>
              {%- endfor -%}
            </div>
          </details>
        {%- else -%}
          <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>
  </div>
</header>

{%- style -%}
  .mega-panel {
    position: absolute; left: 0; right: 0; top: 100%; z-index: 58;
    background: var(--off); border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink);
    box-shadow: 0 26px 54px rgba(43,36,29,0.18);
    display: none;
  }
  .mega-panel.is-open { display: block; }
  .mega-panel__grid { display: flex; flex-wrap: wrap; gap: 24px 40px; padding: 28px; }
  .mega-panel__grid a { font-size: 14px; }

  .mobile-nav-panel {
    position: fixed; inset: 0; z-index: 90; background: var(--off);
    display: none; flex-direction: column; overflow-y: auto;
  }
  .mobile-nav-panel.is-open { display: flex; }
  .mobile-nav-panel__head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 20px; border-bottom: 2px solid var(--ink);
  }
  .mobile-nav-panel__links { display: flex; flex-direction: column; padding: 8px 20px; }
  .mobile-nav-panel__links > a, .mobile-nav-panel__links summary {
    padding: 16px 0; border-bottom: 1px solid var(--color-border);
    font-size: 15px; cursor: pointer; list-style: none;
  }
  .mobile-nav-panel__links summary::-webkit-details-marker { display: none; }
  .mobile-nav-panel__sublinks { display: flex; flex-direction: column; padding: 0 0 12px 12px; }
  .mobile-nav-panel__sublinks a { padding: 10px 0; font-size: 14px; color: var(--terra); }

  @media (max-width: 900px) {
    .site-header__icon-btn[data-mobile-menu-toggle] { display: flex !important; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "t:sections.header.name",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.header.settings.menu.label",
      "default": "main-menu"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "t:sections.header.settings.logo_text.label",
      "default": "EasyBeauty"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "t:sections.header.settings.sticky.label",
      "default": true
    }
  ]
}
{% endschema %}
