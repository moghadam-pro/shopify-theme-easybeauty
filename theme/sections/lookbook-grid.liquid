<section class="section container" style="padding-left:0;padding-right:0">
  <div class="container">
    <h1>{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<p class="text-muted" style="max-width:520px">{{ section.settings.text }}</p>{%- endif -%}
  </div>

  <div class="lookbook-grid" style="margin-top:var(--space-8)">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.product.url | default: '#' }}" class="lookbook-item" {{ block.shopify_attributes }}>
        {%- if block.settings.image -%}
          <img
            src="{{ block.settings.image | image_url: width: 800 }}"
            alt="{{ block.settings.title | escape }}"
            width="800"
            height="{{ 800 | divided_by: block.settings.image.aspect_ratio | default: 1000 }}"
            loading="lazy"
          >
        {%- elsif block.settings.fallback_image != blank -%}
          {%- comment -%}
            shopify://shop_images/... only resolves against a file already in
            the shop's Files library — it doesn't auto-copy theme assets
            there — so a freshly installed theme falls back to its own
            bundled photo via asset_url instead.
          {%- endcomment -%}
          <img
            src="{{ block.settings.fallback_image | asset_url }}"
            alt="{{ block.settings.title | escape }}"
            width="760"
            height="760"
            loading="lazy"
          >
        {%- else -%}
          {%- assign fallback_image = 'lifestyle-skin.jpg,lifestyle-apply.jpg' | split: ',' -%}
          {%- assign fallback_index = forloop.index0 | modulo: 2 -%}
          <img
            src="{{ fallback_image[fallback_index] | asset_url }}"
            alt="{{ block.settings.title | escape }}"
            width="880"
            height="1100"
            loading="lazy"
          >
        {%- endif -%}
        {%- if block.settings.title != blank -%}
          <span class="lookbook-item__tag">{{ block.settings.title }}</span>
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.lookbook-grid.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The formulas, in use."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Four people, eight weeks on the same routine."
    }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "t:sections.lookbook-grid.blocks.look.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.lookbook-grid.blocks.look.settings.image.label"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "t:sections.lookbook-grid.blocks.look.settings.fallback_image.label",
          "info": "t:sections.lookbook-grid.blocks.look.settings.fallback_image.info"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.lookbook-grid.blocks.look.settings.title.label"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.lookbook-grid.blocks.look.settings.product.label"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "look",
        "settings": {
          "title": "Morning routine"
        }
      },
      {
        "type": "look",
        "settings": {
          "title": "Night routine"
        }
      },
      {
        "type": "look",
        "settings": {
          "title": "Barrier repair"
        }
      }
    ]
  }
}
{% endschema %}
