<section class="section container">
  <div class="section__head">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.view_all_link != blank -%}
      <a href="{{ section.settings.view_all_link }}" class="btn-ghost">{{ 'sections.featured-collection.view_all' | t }} &rarr;</a>
    {%- endif -%}
  </div>

  <div class="grid grid--products grid-{{ section.settings.columns_desktop }}">
    {%- assign source_collection = section.settings.collection | default: collections.all -%}
    {%- if source_collection == blank or source_collection.products.size == 0 -%}
      {%- for i in (1..section.settings.products_to_show) -%}
        <div class="product-card">
          <div class="product-card__media">{{ 'product-1' | placeholder_svg_tag: class: 'placeholder-svg' }}</div>
          <div class="product-card__title">Example product</div>
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for product in source_collection.products limit: section.settings.products_to_show -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured-collection.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.featured-collection.settings.heading.label",
      "default": "Best sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured-collection.settings.collection.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "t:sections.featured-collection.settings.products_to_show.label",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:sections.featured-collection.settings.columns_desktop.label",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "4"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "t:sections.featured-collection.settings.view_all_link.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured-collection.presets.name"
    }
  ]
}
{% endschema %}
