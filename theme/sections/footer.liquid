        {
          "type": "url",
          "id": "url_1",
          "label": "t:sections.footer.blocks.links.settings.url.label"
        },
        {
          "type": "text",
          "id": "label_2",
          "label": "t:sections.footer.blocks.links.settings.label.label"
        },
        {
          "type": "url",
          "id": "url_2",
          "label": "t:sections.footer.blocks.links.settings.url.label"
        },
        {
          "type": "text",
          "id": "label_3",
          "label": "t:sections.footer.blocks.links.settings.label.label"
        },
        {
          "type": "url",
          "id": "url_3",
          "label": "t:sections.footer.blocks.links.settings.url.label"
        },
        {
          "type": "text",
          "id": "label_4",
          "label": "t:sections.footer.blocks.links.settings.label.label"
        },
        {
          "type": "url",
          "id": "url_4",
          "label": "t:sections.footer.blocks.links.settings.url.label"
        },
        {
          "type": "text",
          "id": "label_5",
          "label": "t:sections.footer.blocks.links.settings.label.label"
        },
        {
          "type": "url",
          "id": "url_5",
          "label": "t:sections.footer.blocks.links.settings.url.label"
        },
        {
          "type": "text",
          "id": "label_6",
          "label": "t:sections.footer.blocks.links.settings.label.label"
        },
        {
          "type": "url",
          "id": "url_6",
          "label": "t:sections.footer.blocks.links.settings.url.label"
        }
      ]
    },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.footer.blocks.link_list.settings.title.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.footer.blocks.text.settings.title.label"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:sections.footer.blocks.text.settings.content.label"
        }
