    {
      "type": "text",
      "id": "tagline",
      "label": "t:sections.footer.settings.tagline.label",
      "default": "Clean, clinically supported skincare. Made in Portugal."
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:sections.footer.settings.show_newsletter.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header_legal.content"
    },
    {
      "type": "text",
      "id": "legal_label_1",
      "label": "t:sections.footer.settings.legal_label.label",
      "default": "Privacy"
    },
    {
      "type": "url",
      "id": "legal_url_1",
      "label": "t:sections.footer.settings.legal_url.label"
    },
    {
      "type": "text",
      "id": "legal_label_2",
      "label": "t:sections.footer.settings.legal_label.label",
      "default": "Terms"
    },
    {
      "type": "url",
      "id": "legal_url_2",
      "label": "t:sections.footer.settings.legal_url.label"
    },
    {
