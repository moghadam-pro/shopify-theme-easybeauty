<footer class="site-footer">
  <div class="site-footer__grid">
    <div>
      <div class="site-footer__brand">{{ section.settings.brand | default: shop.name }}</div>
      {%- if section.settings.tagline != blank -%}<p class="site-footer__tagline">{{ section.settings.tagline }}</p>{%- endif -%}

      {%- if section.settings.show_newsletter -%}
        <div data-newsletter-wrapper>
          {%- form 'customer', id: 'FooterNewsletterForm', class: 'site-footer__newsletter-form', data-newsletter-form: true -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label for="FooterNewsletterEmail" class="visually-hidden">{{ 'general.newsletter.email_placeholder' | t }}</label>
            <input
              type="email"
              name="contact[email]"
              id="FooterNewsletterEmail"
              class="input"
              placeholder="{{ 'general.newsletter.email_placeholder' | t }}"
              required
            >
            <button type="submit" class="btn btn-primary" data-success-text="{{ 'general.newsletter.success' | t }}" data-error-text="{{ 'general.newsletter.error' | t }}">
              {{ 'general.newsletter.submit' | t }}
            </button>
          {%- endform -%}
          <p class="form-message" data-form-message hidden></p>
        </div>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'link_list' and block.settings.menu.links == blank -%}{%- continue -%}{%- endif -%}
      <div {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when 'link_list' -%}
            <div class="site-footer__heading">{{ block.settings.title }}</div>
            <div class="site-footer__links">
              {%- for link in block.settings.menu.links -%}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {%- endfor -%}
            </div>
          {%- when 'links' -%}
            <div class="site-footer__heading">{{ block.settings.title }}</div>
            <div class="site-footer__links">
              {%- for i in (1..6) -%}
                {%- liquid
                  assign label_key = 'label_' | append: i
                  assign url_key = 'url_' | append: i
                  assign link_label = block.settings[label_key]
                  assign link_url = block.settings[url_key]
                -%}
                {%- if link_label != blank -%}<a href="{{ link_url | default: '#' }}">{{ link_label }}</a>{%- endif -%}
              {%- endfor -%}
            </div>
          {%- when 'text' -%}
            <div class="site-footer__heading">{{ block.settings.title }}</div>
            <div class="site-footer__links rte">{{ block.settings.content }}</div>
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="site-footer__bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand | default: shop.name }}</span>
    <span class="site-footer__legal">
      {%- for i in (1..3) -%}
        {%- liquid
          assign label_key = 'legal_label_' | append: i
          assign url_key = 'legal_url_' | append: i
        -%}
        {%- if section.settings[label_key] != blank -%}<a href="{{ section.settings[url_key] | default: '#' }}">{{ section.settings[label_key] }}</a>{%- endif -%}
      {%- endfor -%}
    </span>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    {
      "type": "text",
      "id": "brand",
      "label": "t:sections.footer.settings.brand.label",
      "info": "t:sections.footer.settings.brand.info"
