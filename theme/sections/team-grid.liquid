<section class="section container">
  <div class="section__head"><h2>{{ section.settings.heading }}</h2></div>
  <div class="grid grid-4">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        {%- if block.settings.image -%}
          <img src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ block.settings.name | escape }}" width="500" height="{{ 500 | divided_by: block.settings.image.aspect_ratio | default: 625 }}" loading="lazy" style="aspect-ratio:4/5;object-fit:cover;margin-bottom:10px" class="grayscale">
        {%- endif -%}
        <div class="card-title" style="font-size:16px">{{ block.settings.name }}</div>
        <div class="text-muted" style="font-size:13px">{{ block.settings.role }}</div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.team-grid.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A team of nine, four of them chemists."
    }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "t:sections.team-grid.blocks.member.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.team-grid.blocks.member.settings.image.label"
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:sections.team-grid.blocks.member.settings.name.label"
        },
        {
          "type": "text",
          "id": "role",
          "label": "t:sections.team-grid.blocks.member.settings.role.label"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "member",
        "settings": {
          "name": "Inês Rocha",
          "role": "Founder & formulation lead"
        }
      },
      {
        "type": "member",
        "settings": {
          "name": "Marco Silva",
          "role": "Chemist"
        }
      }
    ]
  }
}
{% endschema %}
