<section class="team-grid">
  <div class="team-grid__head">
    {%- if section.settings.eyebrow != blank -%}<div class="kicker">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="team-grid__grid">
    {%- for block in section.blocks -%}
      <div class="team-grid__member" {{ block.shopify_attributes }}>
        <div class="team-grid__photo">
          {%- if block.settings.image -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.name | escape }}" width="600" height="{{ 600 | divided_by: block.settings.image.aspect_ratio | round }}" loading="lazy">
          {%- elsif block.settings.fallback_image != blank -%}
            <img src="{{ block.settings.fallback_image | asset_url }}" alt="{{ block.settings.name | escape }}" width="600" height="750" loading="lazy">
          {%- endif -%}
        </div>
        <div class="team-grid__body">
          <div class="team-grid__name">{{ block.settings.name }}</div>
          <div class="team-grid__role">{{ block.settings.role }}</div>
          {%- if block.settings.bio != blank -%}<div class="team-grid__bio">{{ block.settings.bio }}</div>{%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.team-grid.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.team-grid.settings.eyebrow.label",
      "default": "The people who sign the batch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.team-grid.settings.heading.label",
      "default": "A team of nine, four of them chemists."
    }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "t:sections.team-grid.blocks.member.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.team-grid.blocks.member.settings.image.label"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "t:sections.team-grid.blocks.member.settings.fallback_image.label"
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:sections.team-grid.blocks.member.settings.name.label"
        },
        {
          "type": "text",
          "id": "role",
          "label": "t:sections.team-grid.blocks.member.settings.role.label"
        },
        {
          "type": "textarea",
          "id": "bio",
          "label": "t:sections.team-grid.blocks.member.settings.bio.label"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "member",
        "settings": {
          "name": "Inês Rocha",
          "role": "Founder & formulation lead"
        }
      },
      {
        "type": "member",
        "settings": {
          "name": "Marco Silva",
          "role": "Chemist"
        }
      }
    ]
  }
}
{% endschema %}
