{%- comment -%}
  Full-bleed hero with shoppable hotspots. The photo and its hotspots sit on
  one "canvas" that can be zoomed from its left edge (image_shift), which
  slides the subject right and clears room for copy on the left without
  leaving an empty strip. Hotspots are positioned in canvas percentages, so
  they stay pinned to the same spot on the photo; theme.js opens a hotspot
  card on hover/focus/tap and keeps it open while the pointer is on the card.
{%- endcomment -%}
{%- liquid
  assign zoom = section.settings.image_shift | divided_by: 100.0 | plus: 1
  assign ratio = 1.887
  if section.settings.image
    assign ratio = section.settings.image.aspect_ratio
  endif
  assign focus_x = section.settings.focus_x | divided_by: 100.0
  assign focus_y = section.settings.focus_y | divided_by: 100.0
-%}
<section
  class="hero hero--copy-{{ section.settings.copy_position }} hero--height-{{ section.settings.height }}"
  style="--hero-zoom: {{ zoom }}; --hero-ratio: {{ ratio }}; --focus-x: {{ focus_x }}; --focus-y: {{ focus_y }}"
  data-hero
>
  <div class="hero__media">
    <div class="hero__canvas">
      {%- if section.settings.image -%}
        <img
          src="{{ section.settings.image | image_url: width: 2400 }}"
          srcset="{{ section.settings.image | image_url: width: 900 }} 900w, {{ section.settings.image | image_url: width: 1600 }} 1600w, {{ section.settings.image | image_url: width: 2400 }} 2400w"
          sizes="100vw"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
          width="2400"
          height="{{ 2400 | divided_by: section.settings.image.aspect_ratio | round }}"
          fetchpriority="high"
          loading="eager"
        >
      {%- else -%}
        <img
          src="{{ 'hero-banner.jpg' | asset_url }}"
          alt="{{ section.settings.heading | escape }}"
          width="1500"
          height="795"
          fetchpriority="high"
          loading="eager"
        >
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'hotspot' -%}
          {%- liquid
            assign spot_product = block.settings.product
            assign spot_title = block.settings.title | default: spot_product.title
            assign spot_url = block.settings.link | default: spot_product.url
            comment
              No product picked yet: fall back to a product search for the
              hotspot title so the card still leads to the product.
            endcomment
            if spot_url == blank and spot_title != blank
              assign spot_query = spot_title | url_encode
              assign spot_url = routes.search_url | append: '?type=product&q=' | append: spot_query
            endif
          -%}
          <div
            class="hotspot hotspot--{{ block.settings.card_side }}"
            data-hotspot
            style="left:{{ block.settings.horizontal_position }}%;top:{{ block.settings.vertical_position }}%"
            {{ block.shopify_attributes }}
          >
            <div class="hotspot__inner">
              <button type="button" class="hotspot__dot" data-hotspot-toggle aria-expanded="false" aria-label="{{ spot_title | escape }}">
                <span class="hotspot__plus" aria-hidden="true">+</span>
                <span class="hotspot__minus" aria-hidden="true">&ndash;</span>
              </button>
              <{% if spot_url != blank %}a href="{{ spot_url }}"{% else %}div{% endif %} class="hotspot__card">
                {%- if block.settings.image -%}
                  <img src="{{ block.settings.image | image_url: width: 124 }}" alt="" width="62" height="62" loading="lazy">
                {%- elsif spot_product.featured_image -%}
                  <img src="{{ spot_product.featured_image | image_url: width: 124 }}" alt="" width="62" height="62" loading="lazy">
                {%- else -%}
                  <img src="{{ block.settings.fallback_image | default: 'sample-product-4.jpg' | asset_url }}" alt="" width="62" height="62" loading="lazy">
                {%- endif -%}
                <span class="hotspot__copy">
                  <span class="hotspot__title">{{ spot_title }}</span>
                  {%- if block.settings.text != blank -%}<span class="hotspot__text">{{ block.settings.text }}</span>{%- endif -%}
                </span>
              </{% if spot_url != blank %}a{% else %}div{% endif %}>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="hero__copy">
    {%- if section.settings.eyebrow != blank -%}<div class="hero__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h1>{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    <div class="hero__actions">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn-primary">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a href="{{ section.settings.button_link_2 | default: '#' }}" class="btn btn-secondary">{{ section.settings.button_label_2 }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.hero.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.hero.settings.image.label"
    },
    {
      "type": "select",
      "id": "copy_position",
      "label": "t:sections.hero.settings.copy_position.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.hero.settings.copy_position.options__1.label"
        },
        {
          "value": "right",
          "label": "t:sections.hero.settings.copy_position.options__2.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.hero.settings.height.label",
      "options": [
        {
          "value": "screen",
          "label": "t:sections.hero.settings.height.options__1.label"
        },
        {
          "value": "image",
          "label": "t:sections.hero.settings.height.options__2.label"
        }
      ],
      "default": "screen"
    },
    {
      "type": "range",
      "id": "focus_x",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "%",
      "label": "t:sections.hero.settings.focus_x.label",
      "default": 52
    },
    {
      "type": "range",
      "id": "focus_y",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "%",
      "label": "t:sections.hero.settings.focus_y.label",
      "info": "t:sections.hero.settings.focus_y.info",
      "default": 40
    },
    {
      "type": "range",
      "id": "image_shift",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "%",
      "label": "t:sections.hero.settings.image_shift.label",
      "info": "t:sections.hero.settings.image_shift.info",
      "default": 8
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.hero.settings.eyebrow.label",
      "default": "EasyBeauty — Clean skincare"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero.settings.heading.label",
      "default": "Love your skin from within"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.hero.settings.text.label",
      "default": "Twelve weightless formulas, dermatologist tested, built for the barrier you already have."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.hero.settings.button_label.label",
      "default": "Shop the edit"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.hero.settings.button_link.label"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "t:sections.hero.settings.button_label_2.label",
      "default": "Take the skin quiz"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "t:sections.hero.settings.button_link_2.label"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "t:sections.hero.blocks.hotspot.name",
      "settings": [
        {
          "type": "range",
          "id": "horizontal_position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "t:sections.hero.blocks.hotspot.settings.horizontal_position.label",
          "default": 50
        },
        {
          "type": "range",
          "id": "vertical_position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "t:sections.hero.blocks.hotspot.settings.vertical_position.label",
          "default": 50
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.hero.blocks.hotspot.settings.image.label"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "t:sections.hero.blocks.hotspot.settings.fallback_image.label",
          "info": "t:sections.hero.blocks.hotspot.settings.fallback_image.info"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.hero.blocks.hotspot.settings.product.label",
          "info": "t:sections.hero.blocks.hotspot.settings.product.info"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.hero.blocks.hotspot.settings.title.label"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.hero.blocks.hotspot.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.hero.blocks.hotspot.settings.link.label"
        },
        {
          "type": "select",
          "id": "card_side",
          "label": "t:sections.hero.blocks.hotspot.settings.card_side.label",
          "options": [
            {
              "value": "right",
              "label": "t:sections.hero.blocks.hotspot.settings.card_side.options__1.label"
            },
            {
              "value": "left",
              "label": "t:sections.hero.blocks.hotspot.settings.card_side.options__2.label"
            }
          ],
          "default": "right"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.presets.name",
      "blocks": [
        {
          "type": "hotspot",
          "settings": {
            "horizontal_position": 70,
            "vertical_position": 55,
            "title": "Radiance Serum No.3",
            "text": "Niacinamide 10%, the one that stopped stinging."
          }
        }
      ]
    }
  ]
}
{% endschema %}
