<section class="hero hero--copy-{{ section.settings.copy_position }}">
  <div class="hero__media">
    {%- if section.settings.image -%}
      <img
        src="{{ section.settings.image | image_url: width: 2200 }}"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        width="2200"
        height="{{ 2200 | divided_by: section.settings.image.aspect_ratio }}"
        fetchpriority="high"
        loading="eager"
      >
    {%- else -%}
      <img
        src="{{ 'hero-banner.jpg' | asset_url }}"
        alt="{{ section.settings.heading | escape }}"
        width="1500"
        height="795"
        fetchpriority="high"
        loading="eager"
      >
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'hotspot' -%}
        <div
          class="hotspot"
          data-hotspot
          style="left:{{ block.settings.horizontal_position }}%;top:{{ block.settings.vertical_position }}%"
          {{ block.shopify_attributes }}
        >
          <button type="button" class="hotspot__dot" data-hotspot-toggle aria-label="{{ block.settings.title }}">
            {% render 'icon', icon: 'plus', size: 14 %}
          </button>
          <div class="hotspot__card">
            {%- if block.settings.image -%}
              <img src="{{ block.settings.image | image_url: width: 120 }}" alt="" width="120" height="120" loading="lazy" style="width:48px;height:48px;object-fit:cover;flex:none">
            {%- else -%}
              <img src="{{ 'sample-product-4.jpg' | asset_url }}" alt="" width="120" height="120" loading="lazy" style="width:48px;height:48px;object-fit:cover;flex:none">
            {%- endif -%}
            <div>
              <div style="font-size:13px;font-weight:600;margin-bottom:4px">{{ block.settings.title }}</div>
              <div style="font-size:12px;color:#6F6559">{{ block.settings.text }}</div>
            </div>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="hero__copy">
    {%- if section.settings.eyebrow != blank -%}<div class="eyebrow" style="color:#5E5347">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h1>{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    <div class="hero__actions">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn-primary">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a href="{{ section.settings.button_link_2 | default: '#' }}" class="btn btn-secondary">{{ section.settings.button_label_2 }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.hero.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.hero.settings.image.label"
    },
    {
      "type": "select",
      "id": "copy_position",
      "label": "t:sections.hero.settings.copy_position.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.hero.settings.copy_position.options__1.label"
        },
        {
          "value": "right",
          "label": "t:sections.hero.settings.copy_position.options__2.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.hero.settings.eyebrow.label",
      "default": "EasyBeauty — Clean skincare"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero.settings.heading.label",
      "default": "Love your skin from within"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.hero.settings.text.label",
      "default": "Twelve weightless formulas, dermatologist tested, built for the barrier you already have."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.hero.settings.button_label.label",
      "default": "Shop the edit"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.hero.settings.button_link.label"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "t:sections.hero.settings.button_label_2.label",
      "default": "Take the skin quiz"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "t:sections.hero.settings.button_link_2.label"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "t:sections.hero.blocks.hotspot.name",
      "settings": [
        {
          "type": "range",
          "id": "horizontal_position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "t:sections.hero.blocks.hotspot.settings.horizontal_position.label",
          "default": 50
        },
        {
          "type": "range",
          "id": "vertical_position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "t:sections.hero.blocks.hotspot.settings.vertical_position.label",
          "default": 50
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.hero.blocks.hotspot.settings.image.label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.hero.blocks.hotspot.settings.title.label"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.hero.blocks.hotspot.settings.text.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.presets.name",
      "blocks": [
        {
          "type": "hotspot",
          "settings": {
            "horizontal_position": 70,
            "vertical_position": 55,
            "title": "Radiance Serum No.3",
            "text": "Niacinamide 10%, the one that stopped stinging."
          }
        }
      ]
    }
  ]
}
{% endschema %}
