<main class="password-page">
  <div class="password-page__inner">
    <h1 class="password-page__logo">{{ shop.name }}</h1>

    {%- if shop.password_message != blank -%}
      <div class="password-page__message rte">{{ shop.password_message }}</div>
    {%- else -%}
      <p class="password-page__message">{{ 'general.password_page.opening_soon' | t }}</p>
    {%- endif -%}

    {%- form 'storefront_password' -%}
      <div class="password-page__form">
        <div class="field">
          <label for="Password">{{ 'general.password_page.password' | t }}</label>
          <input type="password" name="password" id="Password" class="input" autofocus>
        </div>
        {%- if form.errors -%}
          <p class="password-page__error">{{ 'general.password_page.login_form_error' | t }}</p>
        {%- endif -%}
        <button type="submit" class="btn btn-primary btn-block">{{ 'general.password_page.login_form_submit' | t }}</button>
      </div>
    {%- endform -%}

    {%- if section.settings.show_newsletter -%}
      <div style="margin-top:var(--space-8)" data-newsletter-wrapper>
        {%- form 'customer', data-newsletter-form: true -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div style="display:flex;gap:8px">
            <input type="email" name="contact[email]" class="input" placeholder="{{ 'general.newsletter.email_placeholder' | t }}" required>
            <button type="submit" class="btn btn-secondary" data-success-text="{{ 'general.newsletter.success' | t }}" data-error-text="{{ 'general.newsletter.error' | t }}">
              {{ 'general.newsletter.submit' | t }}
            </button>
          </div>
        {%- endform -%}
        <p class="form-message" data-form-message hidden></p>
      </div>
    {%- endif -%}

    {%- if shop.email -%}
      <p class="password-page__admin"><a href="/admin">{{ 'general.password_page.admin_link_html' | t }}</a></p>
    {%- endif -%}
  </div>
</main>

{% schema %}
{
  "name": "t:sections.main-password.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:sections.main-password.settings.show_newsletter.label",
      "default": true
    }
  ]
}
{% endschema %}
