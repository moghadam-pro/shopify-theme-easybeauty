{%- comment -%}
  Square photo tiles ("Shop the texture"), each with a small product card
  pinned bottom-left. The card reads a picked product; without one it falls
  back to the block's own title/price text and thumbnail asset.
{%- endcomment -%}
<section class="image-product-tiles">
  {%- for block in section.blocks -%}
    {%- assign tile_product = block.settings.product -%}
    <div class="image-product-tiles__tile" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        <img
          src="{{ block.settings.image | image_url: width: 1400 }}"
          alt="{{ block.settings.image.alt | escape }}"
          width="1400"
          height="{{ 1400 | divided_by: block.settings.image.aspect_ratio | round }}"
          loading="lazy"
        >
      {%- else -%}
        <img src="{{ block.settings.fallback_image | default: 'lifestyle-skin.jpg' | asset_url }}" alt="" width="1200" height="1200" loading="lazy">
      {%- endif -%}

      {%- liquid
        if tile_product != blank
          assign card_url = tile_product.url
          assign card_title = tile_product.title
        else
          assign card_url = block.settings.link | default: routes.all_products_collection_url
          assign card_title = block.settings.fallback_title
        endif
      -%}
      {%- if card_title != blank -%}
        <a href="{{ card_url }}" class="image-product-tiles__card">
          {%- if tile_product.featured_image != blank -%}
            <img src="{{ tile_product.featured_image | image_url: width: 140 }}" alt="" width="140" height="140" loading="lazy">
          {%- elsif block.settings.fallback_thumbnail != blank -%}
            <img src="{{ block.settings.fallback_thumbnail | asset_url }}" alt="" width="140" height="140" loading="lazy">
          {%- endif -%}
          <div>
            {%- if block.settings.eyebrow != blank -%}<div class="image-product-tiles__eyebrow">{{ block.settings.eyebrow }}</div>{%- endif -%}
            <div class="image-product-tiles__title">{{ card_title }}</div>
            <div class="image-product-tiles__price">
              {%- if tile_product != blank -%}{{ tile_product.price | money }}{%- else -%}{{ block.settings.fallback_price }}{%- endif -%}
            </div>
          </div>
        </a>
      {%- endif -%}
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "t:sections.image-product-tiles.name",
  "settings": [],
  "blocks": [
    {
      "type": "tile",
      "name": "t:sections.image-product-tiles.blocks.tile.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.image-product-tiles.blocks.tile.settings.image.label"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "t:sections.image-product-tiles.blocks.tile.settings.fallback_image.label",
          "info": "t:sections.image-product-tiles.blocks.tile.settings.fallback_image.info"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.image-product-tiles.blocks.tile.settings.product.label"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "t:sections.image-product-tiles.blocks.tile.settings.eyebrow.label",
          "default": "Shop the texture"
        },
        {
          "type": "text",
          "id": "fallback_title",
          "label": "t:sections.image-product-tiles.blocks.tile.settings.fallback_title.label",
          "info": "t:sections.image-product-tiles.blocks.tile.settings.fallback_title.info"
        },
        {
          "type": "text",
          "id": "fallback_price",
          "label": "t:sections.image-product-tiles.blocks.tile.settings.fallback_price.label"
        },
        {
          "type": "text",
          "id": "fallback_thumbnail",
          "label": "t:sections.image-product-tiles.blocks.tile.settings.fallback_thumbnail.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.image-product-tiles.blocks.tile.settings.link.label"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "t:sections.image-product-tiles.presets.name",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "fallback_image": "lifestyle-skin.jpg",
            "fallback_title": "Barrier Repair Cream",
            "fallback_price": "$58",
            "fallback_thumbnail": "sample-product-2.jpg"
          }
        },
        {
          "type": "tile",
          "settings": {
            "fallback_image": "lifestyle-apply.jpg",
            "fallback_title": "Radiance Serum No.3",
            "fallback_price": "$68",
            "fallback_thumbnail": "sample-product-4.jpg"
          }
        }
      ]
    }
  ]
}
{% endschema %}
