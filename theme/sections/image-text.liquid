{%- comment -%}
  Full-bleed split: a 4:5 photo filling one half, copy vertically centred in
  the other (design's "Our story" block). The photo is capped in height so
  the section never runs taller than a screen on wide monitors.
{%- endcomment -%}
<section class="image-text{% if section.settings.layout == 'right' %} is-reversed{% endif %}">
  <div class="image-text__media">
    {%- if section.settings.image -%}
      <img
        src="{{ section.settings.image | image_url: width: 1000 }}"
        alt="{{ section.settings.heading | escape }}"
        width="1000"
        height="{{ 1000 | divided_by: section.settings.image.aspect_ratio | default: 1250 }}"
        loading="lazy"
      >
    {%- elsif section.settings.fallback_image != blank -%}
      {%- comment -%}
        shopify://shop_images/... only resolves against a file already in
        the shop's Files library — it doesn't auto-copy theme assets there
        — so a freshly installed theme falls back to its own bundled photo
        via asset_url instead.
      {%- endcomment -%}
      <img
        src="{{ section.settings.fallback_image | asset_url }}"
        alt="{{ section.settings.heading | escape }}"
        width="880"
        height="1100"
        loading="lazy"
      >
    {%- else -%}
      {%- liquid
        if section.settings.layout == 'right'
          assign fallback_image = 'lifestyle-apply.jpg'
        else
          assign fallback_image = 'lifestyle-skin.jpg'
        endif
      -%}
      <img
        src="{{ fallback_image | asset_url }}"
        alt="{{ section.settings.heading | escape }}"
        width="880"
        height="1100"
        loading="lazy"
      >
    {%- endif -%}
  </div>
  <div class="image-text__copy">
    {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="image-text__link">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.image-text.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image-text.settings.image.label"
    },
    {
      "type": "text",
      "id": "fallback_image",
      "label": "t:sections.image-text.settings.fallback_image.label",
      "info": "t:sections.image-text.settings.fallback_image.info"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.image-text.settings.layout.label",
      "options": [
        {
          "value": "left",
          "label": "Image left"
        },
        {
          "value": "right",
          "label": "Image right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.image-text.settings.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.image-text.settings.heading.label",
      "default": "One lab outside Lisbon, batch-tested before it leaves."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.image-text.settings.text.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.image-text.settings.button_label.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.image-text.settings.button_link.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.image-text.presets.name"
    }
  ]
}
{% endschema %}
