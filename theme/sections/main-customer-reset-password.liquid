<section class="section container" style="max-width:420px">
  <h1>{{ 'customer.reset_password.title' | t }}</h1>
  <p class="text-muted">{{ 'customer.reset_password.subtext_generic' | t }}</p>

  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}
      <div class="form-message form-message--error">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div class="field">
      <label for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
      <input type="password" name="customer[password]" id="ResetPassword" class="input" required>
    </div>
    <div class="field">
      <label for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
      <input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" class="input" required>
    </div>
    <button type="submit" class="btn btn-primary btn-block">{{ 'customer.reset_password.submit' | t }}</button>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "t:sections.main-customer-reset-password.name",
  "settings": [

  ]
}
{% endschema %}
