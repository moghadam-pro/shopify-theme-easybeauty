{%- comment -%}
  Collection header: breadcrumb, title, description (or a fallback line)
  and short badges on the right. Kept separate from main-collection so
  other sections (e.g. category chips) can sit between it and the grid.
{%- endcomment -%}
<div class="collection-hero">
  <div class="container">
    <nav class="page-intro__breadcrumb" aria-label="{{ 'sections.page-intro.breadcrumb' | t }}">
      <a href="{{ routes.root_url }}">{{ 'sections.page-intro.home' | t }}</a> / <span aria-current="page">{{ collection.title }}</span>
    </nav>
    <div class="collection-hero__row">
      <div class="collection-hero__copy">
        <h1>{{ collection.title }}</h1>
        {%- if collection.description != blank -%}<div class="rte">{{ collection.description }}</div>{%- elsif section.settings.fallback_description != blank -%}<p>{{ section.settings.fallback_description }}</p>{%- endif -%}
      </div>
      {%- if section.settings.badges != blank -%}
        <div class="collection-hero__badges">
          {%- assign badges = section.settings.badges | split: '|' -%}
          {%- for badge in badges -%}<span>{{ badge | strip }}</span>{%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.collection-banner.name",
  "settings": [
    {
      "type": "textarea",
      "id": "fallback_description",
      "label": "t:sections.collection-banner.settings.fallback_description.label",
      "info": "t:sections.collection-banner.settings.fallback_description.info"
    },
    {
      "type": "text",
      "id": "badges",
      "label": "t:sections.collection-banner.settings.badges.label",
      "info": "t:sections.collection-banner.settings.badges.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection-banner.presets.name"
    }
  ]
}
{% endschema %}
