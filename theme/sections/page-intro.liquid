{%- comment -%}
  Page header used across content pages: breadcrumb, eyebrow, large title,
  lead paragraph, optional meta line (e.g. opening hours) and up to two
  buttons. The title falls back to the current page/blog title.
{%- endcomment -%}
{%- liquid
  assign intro_title = section.settings.heading
  if intro_title == blank
    assign intro_title = page.title | default: blog.title | default: collection.title
  endif
-%}
{%- liquid
  assign intro_image = section.settings.image
  assign has_image = false
  if intro_image != blank or section.settings.fallback_image != blank
    assign has_image = true
  endif
-%}
<section class="page-intro{% if has_image %} page-intro--media{% endif %}{% if section.settings.grayscale %} page-intro--mono{% endif %}">
  <div class="container">
    {%- if section.settings.show_breadcrumb -%}
      <nav class="page-intro__breadcrumb" aria-label="{{ 'sections.page-intro.breadcrumb' | t }}">
        <a href="{{ routes.root_url }}">{{ 'sections.page-intro.home' | t }}</a> / <span aria-current="page">{{ page.title | default: blog.title | default: intro_title }}</span>
      </nav>
    {%- endif -%}
    {%- if section.settings.eyebrow != blank -%}<div class="page-intro__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
    {%- liquid
      assign meta_right = false
      if section.settings.meta != blank and section.settings.meta_style == 'right'
        assign meta_right = true
      endif
      assign meta_items = section.settings.meta | split: '|'
      assign show_footer = false
      if section.settings.button_label != blank or section.settings.button_label_2 != blank
        assign show_footer = true
      endif
      if section.settings.meta != blank and meta_right == false
        assign show_footer = true
      endif
    -%}
    <div class="page-intro__row">
      <div>
        <h1 class="page-intro__title">{{ intro_title }}</h1>
        {%- if section.settings.text != blank -%}<div class="page-intro__text">{{ section.settings.text }}</div>{%- endif -%}
      </div>
      {%- if meta_right -%}
        <div class="page-intro__side">
          {%- for item in meta_items -%}<span>{{ item | strip }}</span>{%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    {%- if show_footer -%}
      <div class="page-intro__footer">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn-primary">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 | default: '#' }}" class="btn btn-secondary">{{ section.settings.button_label_2 }}</a>
        {%- endif -%}
        {%- if section.settings.meta != blank and meta_right == false -%}
          <div class="page-intro__meta">
            {%- for item in meta_items -%}<span class="tag tag-outline">{{ item | strip }}</span>{%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
  {%- if has_image -%}
    <div class="page-intro__media">
      {%- if intro_image != blank -%}
        {{ intro_image | image_url: width: 1400 | image_tag: loading: 'eager', sizes: '(min-width: 960px) 44vw, 100vw', widths: '600, 1000, 1400', alt: intro_image.alt }}
      {%- else -%}
        <img src="{{ section.settings.fallback_image | asset_url }}" alt="" width="1200" height="1500" loading="eager">
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:sections.page-intro.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "t:sections.page-intro.settings.show_breadcrumb.label",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.page-intro.settings.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.page-intro.settings.heading.label",
      "info": "t:sections.page-intro.settings.heading.info"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.page-intro.settings.text.label"
    },
    {
      "type": "text",
      "id": "meta",
      "label": "t:sections.page-intro.settings.meta.label",
      "info": "t:sections.page-intro.settings.meta.info"
    },
    {
      "type": "select",
      "id": "meta_style",
      "label": "t:sections.page-intro.settings.meta_style.label",
      "options": [
        {
          "value": "tags",
          "label": "t:sections.page-intro.settings.meta_style.options__1.label"
        },
        {
          "value": "right",
          "label": "t:sections.page-intro.settings.meta_style.options__2.label"
        }
      ],
      "default": "tags"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.page-intro.settings.button_label.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.page-intro.settings.button_link.label"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "t:sections.page-intro.settings.button_label_2.label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "t:sections.page-intro.settings.button_link_2.label"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.page-intro.settings.image.label",
      "info": "t:sections.page-intro.settings.image.info"
    },
    {
      "type": "text",
      "id": "fallback_image",
      "label": "t:sections.page-intro.settings.fallback_image.label",
      "info": "t:sections.page-intro.settings.fallback_image.info"
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "t:sections.page-intro.settings.grayscale.label",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:sections.page-intro.presets.name"
    }
  ]
}
{% endschema %}
